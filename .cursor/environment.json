{
  "name": "Overdrive Syndicate Demo",
  "install": "test -f index.html",
  "start": ".cursor/scripts/start-web-server.sh",
  "terminals": [
    {
      "name": "web",
      "command": "python3 -m http.server 8000 --bind 0.0.0.0",
      "description": "Serves the Three.js vehicular combat demo at http://localhost:8000"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 8000
    }
  ]
}
